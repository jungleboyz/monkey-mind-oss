# Required — your LLM and embedding API keys (at least one provider required)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Optional — override provider defaults
MM_LLM_PROVIDER=anthropic        # anthropic | openai | ollama
MM_EMBED_PROVIDER=openai         # openai | ollama

# Optional — override default ports
API_PORT=8000
MCP_PORT=8001

# Optional — data directory (default: ./data)
DATA_ROOT=./data
